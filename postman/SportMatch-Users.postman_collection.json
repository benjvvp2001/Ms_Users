{
  "info": {
    "_postman_id": "1f7a6b8e-2c3d-4a1f-9c2e-sportmatch-users",
    "name": "SportMatch - users service (Postgres)",
    "description": "Prueba end-to-end del microservicio de usuarios contra la base de datos PostgreSQL real (users_db), no el repositorio mock. Cada carpeta cubre un grupo de endpoints del contrato /api/v1/users. Los tokens/ids se encadenan automaticamente via variables de entorno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register User A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('userA_email')) {",
                  "    pm.environment.set('userA_email', 'qa.ana.' + Date.now() + '@example.com');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns access token', () => pm.expect(body.access_token).to.be.a('string'));",
                  "pm.test('role is player', () => pm.expect(body.user.role).to.eql('player'));",
                  "pm.environment.set('userA_token', body.access_token);",
                  "pm.environment.set('userA_id', body.user.user_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userA_email}}\",\n  \"password\": \"{{userA_password}}\",\n  \"nombre\": \"Ana\",\n  \"apellido_paterno\": \"Torres\",\n  \"apellido_materno\": \"Diaz\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "auth", "register"]
            }
          },
          "response": []
        },
