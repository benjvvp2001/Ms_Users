# Set a high-entropy value outside source control before starting the service.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile

# PostgreSQL users-service database. Do not commit a real password.
USERS_DATABASE_URL=postgresql://sportmach_users:replace-with-a-password@localhost:5432/sportmach_users

# Password recovery email (any SMTP provider). Do not commit real credentials.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and an "App password" in SMTP_PASSWORD.
# Outlook/Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
# EMAIL_BACKEND=console prints the email to stdout instead of sending it (local dev only).
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60
# Email verification after registration (same SMTP settings).
EMAIL_VERIFICATION_CODE_MINUTES=30
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60

# Live location for nearby recommendations. Provisional: product has not defined these values yet.
# Distance the person must move before the app sends a new position (the service ignores smaller moves).
LOCATION_MIN_MOVE_METERS=200
# A position older than this is ignored and the fixed profile zone is used instead.
LOCATION_MAX_AGE_MINUTES=1440

# HU-61: fotos de perfil. La carpeta debe estar en un volumen persistente: en la nube el contenedor se reconstruye
# y todo lo que no esté en un volumen se pierde. En Docker Compose es el volumen `users_photos` (ya configurado).
# Fuera de Docker, una carpeta local, p. ej. ./data/profile-photos.
PHOTO_STORAGE_PATH=/data/profile-photos
# Tamaño máximo del archivo que se acepta (bytes). Más grande: 413.
PHOTO_MAX_BYTES=5242880
# Lado mayor tras reprocesar (px). La foto se reduce a este tamaño, nunca se agranda.
PHOTO_MAX_SIDE=1024
# Píxeles máximos que se aceptan decodificar (protege la memoria contra imágenes "bomba").
PHOTO_MAX_PIXELS=40000000

# Dirección del sitio de clubes (sportmatch-web). El login la devuelve a las cuentas de club.
SPORTMATCH_WEB_URL=http://localhost:3000
