# Set a high-entropy value outside source control before starting the service.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile

# PostgreSQL users-service database. Do not commit a real password.
USERS_DATABASE_URL=postgresql://sportmach_users:replace-with-a-password@localhost:5432/sportmach_users
